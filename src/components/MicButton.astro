---
// Drop-in mic toggle for chat surfaces. Owns the lazy-loaded
// LiveSession singleton (the @google/genai SDK and the audio worklet
// shouldn't ship for visitors who never tap the mic).
//
// Renders four states off `data-state`:
//   idle        outline mic icon, ready
//   requesting  dashed accent ring spinning
//   live        solid accent ring + pulsing radial driven by mic level
//   error       danger outline, message in the aria-label
---

<button
  type="button"
  class="mic-btn"
  data-mic-btn
  data-state="idle"
  aria-label="Talk to the assistant"
  aria-pressed="false"
>
  <span class="mic-btn-ring" aria-hidden="true"></span>
  <svg
    class="mic-btn-icon"
    viewBox="0 0 24 24"
    width="14"
    height="14"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="9" y="3" width="6" height="11" rx="3"></rect>
    <path d="M5 11a7 7 0 0 0 14 0"></path>
    <path d="M12 18v3"></path>
  </svg>
</button>

<script>
  import { afterLoad } from "../lib/after-load";

  // Wired once the page has loaded and gone idle, so it never competes with
  // first paint. A click in the moment before then does nothing.
  afterLoad(() => void import("../lib/mic-button"));
</script>

<style>
  .mic-btn {
    position: relative;
    width: 36px;
    height: 36px;
    margin: 0 4px 0 0;
    /* The parent forms use align-items: stretch, which leaves a fixed-
       height child like this one stuck at the cross-axis start. Force
       center so the icon sits on the same horizontal line as the input
       text and the send button. */
    align-self: center;
    border-radius: 999px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-3);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }
  .mic-btn:hover {
    color: var(--ink);
    background: color-mix(in oklab, var(--ink) 6%, transparent);
  }

  .mic-btn-ring {
    position: absolute;
    inset: 2px;
    border-radius: 999px;
    pointer-events: none;
    border: 1px solid transparent;
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      transform 0.2s;
  }

  /* Live: pulsing accent ring driven by --mic-level (0..1). */
  .mic-btn[data-state="live"] {
    color: var(--accent);
  }
  .mic-btn[data-state="live"] .mic-btn-ring {
    border-color: var(--accent);
    box-shadow:
      0 0 0 calc(var(--mic-level, 0) * 6px)
        color-mix(in oklab, var(--accent) 22%, transparent),
      inset 0 0 calc(4px + var(--mic-level, 0) * 6px)
        color-mix(in oklab, var(--accent) 18%, transparent);
    animation: mic-live-pulse 1.6s ease-in-out infinite;
  }
  @keyframes mic-live-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.06); }
  }

  /* Requesting: dashed spinning ring. */
  .mic-btn[data-state="requesting"] {
    color: var(--ink-2);
    cursor: progress;
  }
  .mic-btn[data-state="requesting"] .mic-btn-ring {
    border: 1px dashed
      color-mix(in oklab, var(--accent) 60%, transparent);
    animation: mic-spin 1.1s linear infinite;
  }
  @keyframes mic-spin {
    to { transform: rotate(1turn); }
  }

  .mic-btn[data-state="error"] {
    color: var(--danger);
  }
  .mic-btn[data-state="error"] .mic-btn-ring {
    border-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .mic-btn[data-state="live"] .mic-btn-ring,
    .mic-btn[data-state="requesting"] .mic-btn-ring {
      animation: none;
    }
  }
</style>
