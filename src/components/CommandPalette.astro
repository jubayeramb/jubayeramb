---
// Command palette shell. The dialog markup is tiny and persists across
// navigations; the search logic, its styles (src/styles/features/
// palette.css) and the index (/palette.json) load the first time it's
// opened or when the visitor hovers the search button.
---

<dialog id="palette" class="palette" aria-label="Command menu" transition:persist="palette">
  <div class="palette-card">
    <div class="palette-input-row">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        id="palette-input"
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-results"
        aria-autocomplete="list"
        aria-label="Search posts, projects and actions"
        placeholder="Search posts, projects, actions…"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="palette-esc">esc</kbd>
    </div>
    <ul id="palette-results" class="palette-results" role="listbox" aria-label="Results"></ul>
    <button id="palette-ask" type="button" class="palette-ask">
      <span class="palette-ask-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12Z"></path>
        </svg>
      </span>
      <span class="palette-ask-text">
        <span class="palette-ask-label">Ask my CV</span>
        <span class="palette-ask-query" id="palette-ask-query">anything</span>
      </span>
      <kbd class="palette-ask-arrow" aria-hidden="true">↵</kbd>
    </button>
    <div class="palette-foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> select</span>
      <span><kbd>⌘↵</kbd> ask</span>
    </div>
  </div>
</dialog>

<script>
  type PaletteModule = typeof import("../lib/palette");
  let loading: Promise<PaletteModule> | null = null;
  const load = () => (loading ??= import("../lib/palette"));

  const inField = () => {
    const el = document.activeElement as HTMLElement | null;
    return !!el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.isContentEditable);
  };

  document.addEventListener("keydown", (e) => {
    if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      load().then((m) => m.togglePalette());
    } else if (e.key === "/" && !inField()) {
      const dialog = document.getElementById("palette") as HTMLDialogElement | null;
      if (dialog?.open) return;
      e.preventDefault();
      load().then((m) => m.openPalette());
    }
  });
  window.addEventListener("palette:open", () => load().then((m) => m.togglePalette()));
  window.addEventListener("palette:warm", () => void load());
</script>
