---
// The header's visible search affordance. Click dispatches palette:open;
// the palette module itself loads on first use (see CommandPalette.astro).
---

<button type="button" class="search-trigger" id="search-trigger" aria-label="Search the site" aria-keyshortcuts="Meta+K Control+K">
  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <span class="search-trigger__label">Search</span>
  <kbd class="search-trigger__kbd" aria-hidden="true">⌘K</kbd>
</button>

<script>
  const wireSearchTrigger = () => {
    const btn = document.getElementById("search-trigger");
    if (!btn || (btn as any).__wired) return;
    (btn as any).__wired = true;
    // Show the right modifier outside Apple platforms.
    if (!/Mac|iPhone|iPad/.test(navigator.userAgent)) {
      const kbd = btn.querySelector(".search-trigger__kbd");
      if (kbd) kbd.textContent = "Ctrl K";
    }
    btn.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("palette:open"));
    });
    // Warm the palette module on intent so the first open is instant.
    btn.addEventListener("pointerenter", () => window.dispatchEvent(new CustomEvent("palette:warm")), {
      once: true,
    });
  };
  wireSearchTrigger();
  document.addEventListener("astro:page-load", wireSearchTrigger);
</script>

<style>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 2.25rem;
    min-width: 2.25rem;
    padding: 0;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-size: var(--text-sm);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .search-trigger:hover {
    color: var(--ink);
    border-color: var(--control);
    background: var(--surface);
  }
  .search-trigger__label,
  .search-trigger__kbd {
    display: none;
  }
  @media (width >= 64rem) {
    .search-trigger {
      padding: 0 0.45rem 0 0.8rem;
    }
    .search-trigger__label,
    .search-trigger__kbd {
      display: inline;
    }
  }
  .search-trigger__kbd {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background: color-mix(in oklab, var(--ink) 7%, transparent);
    color: var(--ink-2);
  }
</style>
