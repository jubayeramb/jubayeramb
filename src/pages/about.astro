---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Timeline from "@/components/ui/Timeline.astro";
import type { TimelineItem } from "@/types/ui";
import aboutPhoto from "@/assets/portrait/about.jpg";
import jobsHistory from "@data/jobs.json";
import recognition from "@data/recognition.json";
import education from "@data/education.json";
import type { JobDescription } from "@/types";
import { AUTHOR } from "@/lib/site";
import { getMonthYear } from "@/utils";

const jobs = Object.values(jobsHistory as Record<string, JobDescription>).sort(
  (a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime(),
);

const experience: TimelineItem[] = jobs.map((job) => {
  const startYear = job.startDate.split("-")[0];
  const endYear = job.endDate ? job.endDate.split("-")[0] : "";
  return {
    label: endYear ? (endYear === startYear ? startYear : `${startYear}–${endYear.slice(2)}`) : `${startYear}–now`,
    title: job.designation,
    org: job.company,
    href: job.url,
    detail: `${getMonthYear(job.startDate)} – ${job.endDate ? getMonthYear(job.endDate) : "Present"}`,
    description: job.description,
    tags: job.technologies,
  };
});

const awards: TimelineItem[] = recognition.map((r) => ({
  label: r.year,
  title: r.title,
  org: r.context,
  description: r.description,
}));

const schooling: TimelineItem[] = education.map((e) => ({
  label: e.period,
  title: e.degree,
  org: e.school,
  href: e.url,
  detail: e.dates,
}));

const stack = [
  "TypeScript",
  "React",
  "Next.js",
  "Node.js",
  "React Native",
  "PostgreSQL",
  "MongoDB",
  "Redis",
  "Prisma",
  "Tailwind",
  "Docker",
];

const title = "About";
const description =
  "About Jubayer Al Mamun, software engineer based in Dhaka, Bangladesh. CS graduate from Green University of Bangladesh, mostly self-taught. Currently at WeCycle.";
---

<Layout {title} {description} type="profile" profilePage activeRoute="about">
  <section class="band about-hero" aria-labelledby="about-title">
    <div class="container about-hero__grid">
      <div>
        <p class="eyebrow">{AUTHOR.name}</p>
        <h1 id="about-title" class="page-title about-hero__title">About</h1>
        <p class="lead">
          I'm a software engineer based in <strong>Dhaka, Bangladesh</strong>, mostly self-taught,
          currently working at <a class="link" href={AUTHOR.employer.url} target="_blank" rel="noopener"
            >{AUTHOR.employer.name}</a
          >. I've spent the last few years shipping production software end to end: services,
          schemas, and interfaces.
        </p>
        <div class="about-more">
          <h2 class="eyebrow">A little more</h2>
          <p>
            I started programming in 2020, by accident, mostly. I opened a stylesheet, and never really
            stopped. Since then I've shipped products at small startups, contributed to open source,
            and helped a handful of teams move faster without breaking things.
          </p>
          <p>
            My work tends toward <strong>simple, fast, and considered</strong>. I'm at my best when I
            can own a problem from data model to interaction detail.
          </p>
        </div>
      </div>
      <figure class="about-photo">
        <Picture
          src={aboutPhoto}
          alt={`${AUTHOR.name} in a light blue shirt against a grey backdrop`}
          widths={[320, 480, 640, 960, 1208]}
          sizes="(width >= 64rem) 24rem, (width >= 48rem) 50vw, 100vw"
          formats={["avif", "webp"]}
          loading="eager"
          decoding="async"
          class="about-photo__img"
        />
      </figure>
    </div>
  </section>

  <section class="band band--alt" aria-labelledby="experience">
    <div class="container">
      <SectionHeader eyebrow="Career" title="Experience" id="experience" />
      <Timeline items={experience} />
    </div>
  </section>

  <section class="band" aria-labelledby="recognition">
    <div class="container">
      <SectionHeader eyebrow="Awards" title="Recognition" id="recognition" />
      <Timeline items={awards} />
    </div>
  </section>

  <section class="band band--alt" aria-labelledby="education">
    <div class="container">
      <SectionHeader eyebrow="School" title="Education" id="education" />
      <Timeline items={schooling} />
    </div>
  </section>

  <section class="band" aria-labelledby="stack">
    <div class="container">
      <SectionHeader eyebrow="Tools" title="Stack" id="stack" />
      <ul class="stack-chips">
        {stack.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }
  .about-hero__grid {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }
  @media (width >= 48rem) {
    .about-hero__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-12);
    }
  }
  .about-hero__title {
    margin-block: var(--space-4) var(--space-6);
  }
  .about-more {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--hairline);
    max-width: 40rem;
    color: var(--ink-2);
  }
  .about-photo {
    order: -1;
    max-width: 24rem;
  }
  @media (width >= 48rem) {
    .about-photo {
      order: 0;
      justify-self: end;
      width: 100%;
    }
  }
  .about-photo :global(.about-photo__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-card);
    border: 1px solid var(--hairline);
  }

  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .stack-chips li {
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-control);
    background: var(--ink);
    color: var(--canvas);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link) {
      display: none;
    }
    .band {
      padding-block: 1.25rem;
      background: none;
    }
  }
</style>
