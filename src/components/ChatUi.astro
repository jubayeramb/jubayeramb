---
import MicButton from "./MicButton.astro";

type Props = {
  mode?: "page" | "overlay";
};
const { mode = "page" } = Astro.props;
---

<section class="chat" data-mode={mode} aria-label="Ask about Jubayer">
  <div class="chat-scroll" id="chat-scroll">
    <ol class="chat-bubbles" id="chat-stream" aria-live="polite"></ol>
    {
      mode === "page" && (
        <div class="chat-seed" id="chat-seed">
          <div class="chat-seed-label">Try</div>
          <ul class="chat-seed-list">
            <li>
              <button
                type="button"
                data-suggest="What is Jubayer working on right now?"
              >
                What is Jubayer working on right now?
              </button>
            </li>
            <li>
              <button
                type="button"
                data-suggest="Has Jubayer shipped payment infrastructure?"
              >
                Has Jubayer shipped payment infrastructure?
              </button>
            </li>
            <li>
              <button
                type="button"
                data-suggest="Walk me through the WeCycle monolith → microservices migration."
              >
                Walk me through the WeCycle monolith → microservices migration.
              </button>
            </li>
          </ul>
        </div>
      )
    }
  </div>

  <div class="chat-foot">
    <form class="chat-form" id="chat-form" action="/ask/" method="get" autocomplete="off">
      <input
        class="chat-input"
        id="chat-input"
        type="text"
        name="q"
        placeholder="Ask anything…"
        autocomplete="off"
        spellcheck="false"
        maxlength="500"
        required
      />
      <MicButton />
      <button class="chat-send" id="chat-send" type="submit" aria-label="Send">
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </button>
    </form>

    <p class="chat-disclaimer">
      AI-generated. Answers may be wrong, so DM me to confirm. Stored
      locally only.
      <button
        type="button"
        id="chat-clear"
        class="chat-clear"
        hidden
        aria-label="Clear chat history"
      >
        Clear
      </button>
    </p>
  </div>
</section>

<script>
  import { afterLoad } from "../lib/after-load";

  // Wired once the page has loaded and gone idle, so this and chat-store
  // never compete with first paint. A question submitted before then falls
  // back to the form's action, /ask/?q=, which asks it there.
  afterLoad(() => void import("../lib/chat-ui"));
</script>

<style is:global>
  /* Chat container */
  section.chat {
    display: flex;
    flex-direction: column;
    min-height: 0;
    width: 100%;
  }
  section.chat[data-mode="page"] {
    margin-top: 24px;
    height: min(72vh, 640px);
  }
  section.chat[data-mode="overlay"] {
    flex: 1;
    height: 100%;
  }

  /* Scrollable region - bubbles anchor to the bottom (via margin-top: auto
     on the inner list) so latest stays in view, but the user can scroll up
     to read older messages. Scrollbar is hidden - chat-app convention. */
  .chat-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    padding: 16px 4px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .chat-scroll::-webkit-scrollbar {
    width: 0;
    height: 0;
    display: none;
  }
  section.chat[data-mode="overlay"] .chat-scroll {
    /* Bubbles flow under the floating close/maximize buttons; the top
       72px fade mask makes them dissolve as they approach the buttons. */
    padding: 72px 8px 8px;
    mask-image: linear-gradient(to bottom, transparent 0, #000 72px, #000);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 72px,
      #000
    );
  }
  /* Same dissolve treatment on the dedicated /ask page so older bubbles
     fade as they scroll up. */
  section.chat[data-mode="page"] .chat-scroll {
    mask-image: linear-gradient(to bottom, transparent 0, #000 56px, #000);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 56px,
      #000
    );
  }

  .chat-bubbles {
    list-style: none;
    margin-top: auto;
    margin-bottom: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* The actual bubbles - used here AND in HomeChatInput preview. */
  .bubble {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: min(80%, 560px);
    padding: 10px 14px;
    border-radius: 16px;
    line-height: 1.5;
    word-wrap: break-word;
    overflow-wrap: anywhere;
    /* Fade-in only - no translate. We mount each bubble exactly once
       now (see the incremental render in src/lib/chat-ui.ts), so this
       animation runs on entrance and never re-fires while text streams
       in. The bubble's own block layout handles smooth height growth. */
    animation: bubble-in 240ms var(--ease, cubic-bezier(0.22, 1, 0.36, 1)) both;
  }
  @keyframes bubble-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .bubble--user {
    align-self: flex-end;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 14.5px;
    border-bottom-right-radius: 6px;
  }
  .bubble--assistant {
    align-self: flex-start;
    background: var(--surface);
    color: var(--ink);
    font-size: 15.5px;
    border: 1px solid var(--hairline);
    border-bottom-left-radius: 6px;
  }

  .bubble-body {
    white-space: pre-wrap;
  }
  /* Caret blink while streaming text in (not the empty initial state). */
  .bubble--assistant.bubble--streaming
    .bubble-body:not(:has(.bubble-typing))::after {
    content: "▍";
    margin-left: 1px;
    font-weight: 100;
    color: var(--ink-3);
    animation: bubble-blink 1s infinite;
  }
  @keyframes bubble-blink {
    50% {
      opacity: 0.2;
    }
  }

  /* Voice metadata tag - small label so visitors can tell which turns
     came from the live mic vs. typed text. */
  .bubble-via {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-3);
    opacity: 0.7;
    letter-spacing: 0.04em;
  }
  .bubble--user .bubble-via {
    align-self: flex-end;
    color: color-mix(in oklab, var(--on-accent) 75%, transparent);
    opacity: 0.85;
  }

  /* Speaking: subtle accent ring so the visitor sees which assistant
     bubble is currently producing audio. */
  .bubble--speaking {
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--accent) 35%, transparent),
      0 0 18px -6px color-mix(in oklab, var(--accent) 35%, transparent);
    animation: bubble-speaking-pulse 1.6s ease-in-out infinite;
  }
  @keyframes bubble-speaking-pulse {
    0%,
    100% {
      box-shadow:
        0 0 0 1px color-mix(in oklab, var(--accent) 35%, transparent),
        0 0 14px -8px color-mix(in oklab, var(--accent) 30%, transparent);
    }
    50% {
      box-shadow:
        0 0 0 1px color-mix(in oklab, var(--accent) 50%, transparent),
        0 0 22px -4px color-mix(in oklab, var(--accent) 45%, transparent);
    }
  }

  /* Three-dot typing indicator before first delta arrives. */
  .bubble-typing {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 2px;
  }
  .bubble-typing > span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--ink-3) 80%, transparent);
    animation: bubble-typing 1.3s infinite ease-in-out both;
  }
  .bubble-typing > span:nth-child(2) {
    animation-delay: 0.18s;
  }
  .bubble-typing > span:nth-child(3) {
    animation-delay: 0.36s;
  }
  @keyframes bubble-typing {
    0%,
    80%,
    100% {
      transform: scale(0.55);
      opacity: 0.35;
    }
    40% {
      transform: scale(1);
      opacity: 1;
    }
  }

  .bubble-error {
    color: var(--danger);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* Inline source footnote - small, low-opacity, separator dots. */
  .bubble-sources {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.5;
    color: var(--ink-3);
    opacity: 0.7;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 6px;
  }
  .bubble-sources-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-right: 4px;
  }
  .bubble-sources a {
    color: var(--ink-3);
    border-bottom: 1px solid color-mix(in oklab, var(--ink) 14%, transparent);
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .bubble-sources a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .bubble-sources-sep {
    color: var(--ink-3);
    opacity: 0.5;
  }

  /* Seed (page mode only, empty state) */
  .chat-seed {
    align-self: flex-start;
    margin-bottom: 12px;
    padding: 14px 16px;
    border: 1px dashed var(--hairline-strong);
    border-radius: var(--radius-card);
    background: var(--surface);
    max-width: min(86%, 540px);
  }
  .chat-seed[hidden] {
    display: none;
  }
  .chat-seed-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 6px;
  }
  .chat-seed-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .chat-seed-list button {
    text-align: left;
    color: var(--ink-2);
    font-family: var(--font-body);
    font-size: 14.5px;
    line-height: 1.45;
    padding: 6px 0;
    border-bottom: 1px dashed var(--hairline);
    transition:
      color 0.2s,
      border-color 0.2s;
    width: 100%;
    cursor: pointer;
  }
  .chat-seed-list li:last-child button {
    border-bottom: 0;
  }
  .chat-seed-list button:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* Footer (input + disclaimer) */
  .chat-foot {
    flex-shrink: 0;
    padding-top: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  section.chat[data-mode="overlay"] .chat-foot {
    padding-bottom: max(env(safe-area-inset-bottom, 0), 8px);
  }

  .chat-form {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-bg);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    overflow: hidden;
    transition: border-color 0.2s;
  }
  section.chat[data-mode="page"] .chat-form {
    background: var(--surface);
    border-color: var(--hairline-strong);
  }
  .chat-form:focus-within {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--hairline));
  }
  .chat-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 14.5px;
    padding: 13px 16px;
  }
  .chat-input::placeholder {
    color: var(--ink-3);
  }
  .chat-input:disabled {
    color: var(--ink-3);
  }
  .chat-send {
    padding: 0 18px;
    color: var(--ink-3);
    transition:
      color 0.2s,
      background 0.2s;
    flex-shrink: 0;
  }
  .chat-send:hover:not(:disabled) {
    color: var(--accent);
    background: color-mix(in oklab, var(--ink) 6%, transparent);
  }
  .chat-send:disabled {
    opacity: 0.4;
    cursor: progress;
  }

  .chat-disclaimer {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-3);
    line-height: 1.55;
    text-align: center;
    margin: 0;
    padding: 0 8px;
  }
  .chat-clear {
    display: inline;
    font: inherit;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--hairline-strong);
    border-radius: 0;
    color: var(--ink-2);
    padding: 0 0 1px;
    margin-left: 6px;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .chat-clear:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .chat-clear[hidden] {
    display: none;
  }

  @media (max-width: 480px) {
    section.chat[data-mode="page"] {
      height: min(70vh, 560px);
    }
    .bubble {
      max-width: min(86%, 460px);
      padding: 9px 12px;
    }
    .bubble--user {
      font-size: 14px;
    }
    .bubble--assistant {
      font-size: 15px;
    }
    .chat-input {
      padding: 12px 14px;
      font-size: 14px;
    }
    .chat-send {
      padding: 0 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble {
      animation: none;
    }
    .chat-scroll {
      scroll-behavior: auto;
    }
  }
</style>
