---
import MicButton from "./MicButton.astro";

const SUGGESTIONS = [
  "What is Jubayer working on right now?",
  "Has Jubayer shipped payment infrastructure?",
  "Walk me through WeCycle's monolith → microservices migration.",
];
---

<div
  class="home-chat"
  id="home-chat"
  data-state="idle"
  data-history="false"
  aria-label="Ask the assistant"
>
  <div class="home-chat-floats" id="home-chat-floats">
    <div class="home-chat-chips" id="home-chat-chips" hidden>
      {
        SUGGESTIONS.map((s) => (
          <button type="button" class="home-chat-chip" data-suggest={s}>
            {s}
          </button>
        ))
      }
    </div>
    <ol class="home-chat-preview chat-bubbles" id="home-chat-preview" hidden></ol>
  </div>

  <form class="home-chat-form" id="home-chat-form" action="/ask/" method="get" autocomplete="off">
    <svg
      class="home-chat-icon"
      viewBox="0 0 24 24"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
    </svg>
    <input
      class="home-chat-input"
      id="home-chat-input"
      type="text"
      name="q"
      placeholder="Ask anything about Jubayer…"
      autocomplete="off"
      spellcheck="false"
      maxlength="500"
      required
    />
    <MicButton />
    <button class="home-chat-send" type="submit" aria-label="Send">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </button>
  </form>
</div>

<script>
  import { afterLoad } from "../lib/after-load";

  // Wired once the page has loaded and gone idle, so this and chat-store
  // never compete with first paint. A question submitted before then falls
  // back to the form's action, /ask/?q=, which asks it there.
  afterLoad(() => void import("../lib/home-chat-input"));
</script>

<style>
  .home-chat {
    position: fixed;
    left: 50%;
    bottom: max(env(safe-area-inset-bottom, 0), 24px);
    transform: translateX(-50%);
    z-index: var(--z-float);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
    width: min(440px, calc(100vw - 24px));
    transition: width 280ms var(--ease), opacity 200ms var(--ease);
    pointer-events: auto;
  }
  .home-chat[data-state="expanded"] {
    width: min(680px, calc(100vw - 24px));
  }
  .home-chat[data-hidden="true"] {
    opacity: 0;
    pointer-events: none;
  }

  .home-chat-floats {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }

  /* Suggestion chips - only when there is no history. */
  .home-chat-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .home-chat-chips[hidden] { display: none; }
  .home-chat-chip {
    font-family: var(--font-body);
    font-size: 12.5px;
    color: var(--ink-2);
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--hairline-strong);
    box-shadow: var(--shadow-hover);
    cursor: pointer;
    opacity: 0;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .home-chat-chip:hover {
    color: var(--ink);
    border-color: color-mix(in oklab, var(--accent) 40%, transparent);
  }

  /* Preview reuses actual .bubble styles. column-reverse + reversed DOM
     puts the newest bubble flush above the input (full opacity) and older
     ones rise upward. overflow:hidden + mask fades the top. */
  .home-chat-preview {
    list-style: none;
    margin: 0;
    padding: 4px 2px 0;
    max-height: 240px;
    overflow: hidden;
    display: flex;
    flex-direction: column-reverse;
    gap: 8px;
    mask-image: linear-gradient(to top, #000 0, #000 60%, transparent 100%);
    -webkit-mask-image: linear-gradient(to top, #000 0, #000 60%, transparent 100%);
  }
  .home-chat-preview[hidden] { display: none; }
  /* DOM order is newest → oldest; with column-reverse the newest renders
     last visually (at the bottom). Use :nth-child to fade older bubbles. */
  .home-chat-preview .bubble { animation: none; }
  .home-chat-preview .bubble:nth-child(1) { opacity: 0.95; }
  .home-chat-preview .bubble:nth-child(2) { opacity: 0.55; }
  .home-chat-preview .bubble:nth-child(3) { opacity: 0.3; }

  /* Floating input: a solid surface pill, so it reads on the warm canvas
     and over the portrait band alike. */
  .home-chat-form {
    display: flex;
    align-items: stretch;
    background: var(--surface);
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    box-shadow: var(--shadow-float);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  .home-chat[data-state="expanded"] .home-chat-form {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--hairline-strong));
  }
  .home-chat-icon {
    margin: 0 4px 0 16px;
    align-self: center;
    color: var(--accent);
    flex-shrink: 0;
  }
  .home-chat-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 14.5px;
    padding: 14px 12px;
  }
  .home-chat-input::placeholder { color: var(--ink-3); }
  .home-chat-send {
    padding: 0 18px;
    color: var(--ink-3);
    transition: color 0.2s, background 0.2s;
    flex-shrink: 0;
  }
  .home-chat-send:hover {
    color: var(--accent);
    background: color-mix(in oklab, var(--ink) 6%, transparent);
  }

  :global(html[data-nav-open]) .home-chat {
    visibility: hidden;
    opacity: 0;
  }

  @media (max-width: 480px) {
    .home-chat {
      bottom: max(env(safe-area-inset-bottom, 0), 12px);
      /* Idle: a thumb-reach pill, wide enough for the full placeholder. */
      width: min(340px, calc(100vw - 32px));
    }
    /* Focus: expand to nearly full width so typing has room. */
    .home-chat[data-state="expanded"] {
      width: calc(100vw - 16px);
    }
    .home-chat-icon { margin-left: 12px; }
    .home-chat-input { padding: 12px 10px; font-size: 14px; }
    .home-chat-send { padding: 0 14px; }
    .home-chat-preview { max-height: 180px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-chat,
    .home-chat-form { transition: none; }
  }
</style>

<style is:global>
  /* The floating bar sits over the bottom of the page; give the footer
     room so its last line is never hidden behind it. */
  body:has(#home-chat) .site-footer {
    padding-bottom: 8rem;
  }
</style>
