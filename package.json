{
  "name": "jubayeramb",
  "type": "module",
  "version": "0.0.1",
  "author": {
    "name": "Jubayer Al Mamun"
  },
  "description": "Jubayer Al Mamun's personal website",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "pnpm embed && pnpm og && pnpm now",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:dist": "tsx scripts/check-dist.ts",
    "verify": "pnpm check && pnpm build && pnpm check:dist",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"scripts/**/*.ts\" \"functions/**/*.ts\" astro.config.ts",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"scripts/**/*.ts\" \"functions/**/*.ts\" astro.config.ts",
    "test:e2e": "playwright test",
    "sync": "astro sync",
    "embed": "tsx scripts/build-embeddings.ts",
    "og": "tsx scripts/build-og-images.ts",
    "now": "tsx scripts/build-now.ts",
    "portraits": "tsx scripts/prepare-portraits.ts",
    "fn": "wrangler pages dev dist --compatibility-date=2026-05-14",
    "dev:fn": "pnpm build && wrangler pages dev dist --compatibility-date=2026-05-14",
    "astro": "astro"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/groq": "^2.0.0",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@google/genai": "^2.0.1",
    "ai": "^5.0.0",
    "astro": "^6.2.0",
    "gray-matter": "^4.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "sanitize-html": "^2.11.0",
    "sharp": "^0.35.4",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "^25.6.2",
    "@types/opentype.js": "^1.3.9",
    "node-html-parser": "^9.0.4",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^1.0.1",
    "satori": "^0.26.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vfile": "6.0.3",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
