---
import Layout from "@/layouts/Layout.astro";
import ChatUi from "@/components/ChatUi.astro";

const title = "Ask my CV";
const description =
  "A small RAG chat that answers questions about Jubayer Al Mamun's work, projects, and writing, citing sources from this site.";
---

<Layout {title} {description} activeRoute="ask" noindex hideFooter>
  <div class="ask-shell container container--form">
    <h1 class="sr-only">Ask my CV</h1>
    <ChatUi mode="page" />
  </div>
</Layout>

<script>
  import { send } from "@/lib/chat-store";

  const handleAskQueryParam = () => {
    const params = new URLSearchParams(window.location.search);
    const q = params.get("q")?.trim();
    if (!q) return;
    history.replaceState({}, "", "/ask/");
    requestAnimationFrame(() => send(q));
  };

  handleAskQueryParam();
  document.addEventListener("astro:page-load", handleAskQueryParam);
</script>

<style>
  /* A dedicated chat page: the chat fills the viewport under the sticky
     header, and only the message list scrolls. */
  :global(body:has(.ask-shell)) {
    height: 100dvh;
    overflow: hidden;
  }
  :global(body:has(.ask-shell) main) {
    display: flex;
    min-height: 0;
  }
  .ask-shell {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding-bottom: max(env(safe-area-inset-bottom, 0px), var(--space-4));
  }
  .ask-shell :global(section.chat[data-mode="page"]) {
    flex: 1;
    height: auto;
    min-height: 0;
    margin-top: 0;
  }
</style>
