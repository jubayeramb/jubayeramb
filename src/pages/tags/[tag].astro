---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import PostRow from "@/components/ui/PostRow.astro";
import { getSortedPosts, type Post } from "@/lib/posts";
import { isThinTag, tagLabel } from "@/lib/tags";
import { getAllUniqueTags } from "@/utils";

export const getStaticPaths = (async () => {
  const posts = await getSortedPosts();
  return getAllUniqueTags(posts).map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
const label = tagLabel(tag);
const count = `${posts.length} ${posts.length === 1 ? "post" : "posts"}`;

const collectionItems = posts.map((p) => ({
  title: p.data.title,
  url: `/writings/${p.id}/`,
  date: p.data.pubDate,
  description: p.data.description,
}));
---

<Layout
  title={`${label} posts`}
  description={`Posts by Jubayer Al Mamun about ${label}. ${count}.`}
  keywords={[label]}
  activeRoute="writings"
  {collectionItems}
  collectionKind="Article"
  robots={isThinTag(posts.length) ? "noindex-follow" : "index"}
>
  <PageHeader title={label} eyebrow={count} back={{ href: "/tags/", label: "All tags" }}>
    <p>Posts tagged {label}.</p>
  </PageHeader>

  <section class="band band--flush-top" aria-label={`Posts tagged ${label}`}>
    <div class="container">
      {posts.map((post) => <PostRow post={post} headingLevel={2} transition={false} />)}
    </div>
  </section>
</Layout>
