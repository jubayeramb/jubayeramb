---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import WorkRow from "@/components/ui/WorkRow.astro";
import { getProjects } from "@/lib/posts";

const projects = await getProjects();

const title = "Projects";
const description =
  "Selected work by Jubayer Al Mamun: production systems owned end to end, with the problem, the architecture, what shipped, the metrics, and what I'd do differently.";

const collectionItems = projects.map((p) => ({
  title: p.data.title,
  url: `/projects/${p.id}/`,
  description: p.data.summary,
}));
---

<Layout {title} {description} activeRoute="projects" {collectionItems} collectionKind="CreativeWork">
  <PageHeader title="Projects" eyebrow="Selected work">
    <p>
      Selected work: production systems I've owned end to end. Each case study covers the problem,
      the architecture, what shipped, the metrics, and what I'd do differently.
    </p>
  </PageHeader>

  <section class="band band--flush-top" aria-label="All projects">
    <div class="container">
      {projects.map((project) => <WorkRow project={project} headingLevel={2} thumbnail />)}
    </div>
  </section>
</Layout>
