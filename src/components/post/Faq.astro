---
/**
 * Frequently asked questions, rendered open (not collapsed) so the text is
 * readable without interaction and matches the FAQPage JSON-LD word for
 * word.
 */
import { inlineMarkdown } from "@/lib/inline-markdown";
import type { FaqItem } from "@/types/seo";

type Props = { items: FaqItem[] };
const { items } = Astro.props;
---

<section class="faq" aria-labelledby="faq">
  <h2 id="faq" class="faq__title">FAQ</h2>
  {
    items.map((f) => (
      <div class="faq__item">
        <h3 class="faq__q" set:html={inlineMarkdown(f.q)} />
        <p class="faq__a" set:html={inlineMarkdown(f.a)} />
      </div>
    ))
  }
</section>

<style>
  .faq__title {
    font-size: var(--text-2xl);
    letter-spacing: -0.022em;
    margin-bottom: var(--space-4);
  }
  .faq__item {
    padding-block: var(--space-5);
    border-top: 1px solid var(--hairline);
  }
  .faq__item:last-child {
    border-bottom: 1px solid var(--hairline);
  }
  .faq__q {
    font-size: var(--text-md);
    letter-spacing: -0.01em;
  }
  .faq__a {
    margin-top: var(--space-2);
    color: var(--ink-2);
  }
  .faq__a :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
  }
</style>
