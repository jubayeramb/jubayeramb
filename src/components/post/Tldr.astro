---
/**
 * Key takeaways at the top of a post. The same text is emitted as
 * BlogPosting.abstract, so answer engines get an author-written summary
 * instead of guessing one.
 */
import { inlineMarkdown } from "@/lib/inline-markdown";

type Props = { items: string[] };
const { items } = Astro.props;
---

<aside class="tldr" aria-labelledby="tldr">
  <h2 id="tldr" class="tldr__title">TL;DR</h2>
  <ul>
    {items.map((item) => <li set:html={inlineMarkdown(item)} />)}
  </ul>
</aside>

<style>
  .tldr {
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--hairline-strong);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-control) var(--radius-card) var(--radius-card) var(--radius-control);
    background: var(--surface);
  }
  .tldr__title {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .tldr ul {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.1em;
    list-style: disc;
  }
  .tldr li::marker {
    color: var(--accent);
  }
</style>
