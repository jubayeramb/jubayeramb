---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Seo from "@/components/Seo.astro";
import CommandPalette from "@/components/CommandPalette.astro";
import { LOCALE, SITE_HOST } from "@/lib/site";
import type { SeoProps } from "@/types/seo";
import "../styles/global.css";

type Props = SeoProps;

const props = Astro.props;
---

<!doctype html>
<html lang={LOCALE.html}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    {/* Page-specific early hints, e.g. the home hero's image preload. First
        in <head> so the LCP image is queued ahead of the fonts. */}
    <slot name="head" />

    {/* Only the two faces used above the fold on every page are preloaded:
        the display face (headings) and upright body text. Mono and italic
        load on demand. */}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-mono" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <Seo {...props} />

    {/* Runs before first paint. Applies the saved or OS theme, and keeps the
        browser UI color (theme-color) in step with the toggle, not just the
        OS setting. */}
    <script is:inline>
      (function () {
        var COLORS = { light: "#f6f8fb", dark: "#0c1015" };
        function applyTheme() {
          var theme;
          try {
            theme = localStorage.getItem("theme");
          } catch (e) {}
          if (theme !== "light" && theme !== "dark") {
            theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          var root = document.documentElement;
          root.setAttribute("data-theme", theme);
          var meta = document.getElementById("theme-color-live");
          if (!meta) {
            meta = document.createElement("meta");
            meta.name = "theme-color";
            meta.id = "theme-color-live";
            document.head.appendChild(meta);
          }
          meta.setAttribute("content", COLORS[theme]);
        }
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
      })();
    </script>

    {
      /*
       * Microsoft Clarity, injected once the browser is idle after load so
       * analytics never competes with rendering. `import.meta.env.PROD`
       * keeps it out of dev, but `astro preview` and *.pages.dev deploys are
       * production builds too, so it also checks the hostname, and skips
       * automated browsers: WebDriver-driven tests, headless bots, and
       * Lighthouse, which sets neither flag but names itself in the UA.
       */
      import.meta.env.PROD && (
        <script
          is:inline
          set:html={`(function(){var h=location.hostname;if((h!==${JSON.stringify(SITE_HOST)}&&h!==${JSON.stringify("www." + SITE_HOST)})||navigator.webdriver||/Chrome-Lighthouse|HeadlessChrome/.test(navigator.userAgent))return;function load(){(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","wou28uhmsb");}function idle(){"requestIdleCallback" in window?requestIdleCallback(load,{timeout:4000}):setTimeout(load,2000);}document.readyState==="complete"?idle():addEventListener("load",idle,{once:true});})();`}
        />
      )
    }

    <ClientRouter />
  </head>
  <body>
    {/* Cloudflare's Email Obfuscation rewrites every mailto into a link that
        needs its render-blocking email-decode.min.js. The address is public
        anyway (JSON-LD, RSS, the command palette), so opt the page out. */}
    <!--email_off-->
    <slot />
    <CommandPalette />
    <!--/email_off-->
  </body>
</html>
