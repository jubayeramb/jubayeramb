---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getImage } from "astro:assets";
import avatarSrc from "@/assets/portrait/avatar.jpg";
import {
  AUTHOR,
  LOCALE,
  NAV,
  SITE_DESCRIPTION,
  SITE_HOST,
  SITE_NAME,
  SOCIALS,
  TITLE_SEPARATOR,
} from "@/lib/site";
import { tagLabel } from "@/lib/tags";
import { stripInlineMarkdown } from "@/lib/inline-markdown";
import type { SeoProps } from "@/types/seo";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  imageAlt,
  keywords = [],
  type = "website",
  pubDate,
  updatedDate,
  tags = [],
  projectMeta,
  collectionItems,
  collectionKind = "WebPage",
  profilePage = false,
  canonical,
  noindex = false,
  robots = noindex ? "noindex" : "index",
  readingStats,
  abstract,
  cover,
  faq,
  markdownAlternate,
  lastModified,
} = Astro.props;

const SITE_URL = Astro.site?.toString().replace(/\/$/, "") ?? "https://jubayeramb.com";
const abs = (path: string) => new URL(path, SITE_URL + "/").toString();

// Stable @ids so every node in the graph references the same Person and
// WebSite instead of redefining them.
const PERSON_ID = `${SITE_URL}/#person`;
const WEBSITE_ID = `${SITE_URL}/#website`;

// A title that already leads with the site name (the home page's
// "Name - Role") is complete; every other page gets the name appended.
const leadsWithName = title.startsWith(SITE_NAME);
const fullTitle = leadsWithName ? title : `${title}${TITLE_SEPARATOR}${SITE_NAME}`;

// Canonical always ends with "/" to match the sitemap
// (build.format = "directory").
const normalizedPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = canonical ?? abs(normalizedPath);
const pageId = `${canonicalUrl}#webpage`;

// og:image is always the generated 1200x630 card for this route
// (scripts/build-og-images.ts), so the declared dimensions are true.
// Routes without a card of their own fall back to the site card.
const ogImagePath = (() => {
  const segments = normalizedPath.split("/").filter(Boolean);
  const candidate = segments.length === 0 ? "og/index.png" : `og/${segments.join("/")}.png`;
  return existsSync(join(process.cwd(), "public", candidate)) ? candidate : "og/index.png";
})();
const ogImage = abs(ogImagePath);
const ogImageAlt = imageAlt ?? (leadsWithName ? title : `${title}, ${SITE_NAME}`);
const ogImageObject = {
  "@type": "ImageObject",
  url: ogImage,
  width: 1200,
  height: 630,
};

// A real portrait for the Person, not a text banner.
const avatar = await getImage({ src: avatarSrc, width: 800, height: 800, format: "jpg" });
const personImage = {
  "@type": "ImageObject",
  "@id": `${SITE_URL}/#portrait`,
  url: abs(avatar.src),
  width: 800,
  height: 800,
  caption: AUTHOR.name,
};

const metaKeywords = [...keywords, ...tags.map(tagLabel), AUTHOR.name, "software engineer"]
  .filter((v, i, a) => a.indexOf(v) === i)
  .slice(0, 12)
  .join(", ");

const ogType = type === "article" ? "article" : type === "profile" ? "profile" : "website";

const robotsContent = {
  index: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  "noindex-follow": "noindex, follow",
  noindex: "noindex, nofollow",
}[robots];

const iso = (d: string | Date | undefined) => (d ? new Date(d).toISOString() : undefined);
const published = iso(pubDate);
const modified = iso(updatedDate) ?? published;

// ─── JSON-LD nodes ──────────────────────────────────────────────────────

const websiteLd = {
  "@type": "WebSite",
  "@id": WEBSITE_ID,
  name: SITE_NAME,
  url: SITE_URL + "/",
  description: SITE_DESCRIPTION,
  inLanguage: LOCALE.ld,
  publisher: { "@id": PERSON_ID },
  // Search action points at /ask, the site's real query surface (a chat
  // over the site's own content).
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${SITE_URL}/ask?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const personLd = {
  "@type": "Person",
  "@id": PERSON_ID,
  name: AUTHOR.name,
  givenName: AUTHOR.givenName,
  familyName: AUTHOR.familyName,
  url: SITE_URL + "/",
  image: personImage,
  jobTitle: AUTHOR.jobTitle,
  description: SITE_DESCRIPTION,
  worksFor: {
    "@type": "Organization",
    name: AUTHOR.employer.name,
    url: AUTHOR.employer.url,
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: AUTHOR.alumniOf.name,
    url: AUTHOR.alumniOf.url,
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: AUTHOR.locality,
    addressCountry: AUTHOR.country,
  },
  knowsAbout: ["TypeScript", "React", "Next.js", "Node.js", "Astro", "PostgreSQL", "Web performance", "SEO"],
  sameAs: SOCIALS.map((s) => s.href),
};

const breadcrumbSegments = normalizedPath.split("/").filter(Boolean);
const sectionLabel = (seg: string) =>
  NAV.find((n) => n.href === `/${seg}/`)?.label ??
  (seg === "tags" ? "Tags" : seg === "ask" ? "Ask" : seg.replace(/-/g, " ").replace(/^\w/, (c) => c.toUpperCase()));
const breadcrumbLd =
  breadcrumbSegments.length > 0
    ? {
        "@type": "BreadcrumbList",
        "@id": `${canonicalUrl}#breadcrumb`,
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL + "/" },
          ...breadcrumbSegments.map((seg, i) => {
            const path = "/" + breadcrumbSegments.slice(0, i + 1).join("/") + "/";
            const isLeaf = i === breadcrumbSegments.length - 1;
            const parent = breadcrumbSegments[i - 1];
            const name = isLeaf && (type === "article" || type === "project")
              ? title
              : parent === "tags"
                ? tagLabel(seg)
                : sectionLabel(seg);
            return { "@type": "ListItem", position: i + 2, name, item: SITE_URL + path };
          }),
        ],
      }
    : null;

const faqLd =
  faq && faq.length > 0
    ? {
        "@type": "FAQPage",
        "@id": `${canonicalUrl}#faq`,
        url: canonicalUrl,
        isPartOf: { "@id": WEBSITE_ID },
        mainEntity: faq.map((f) => ({
          "@type": "Question",
          name: stripInlineMarkdown(f.q),
          acceptedAnswer: { "@type": "Answer", text: stripInlineMarkdown(f.a) },
        })),
      }
    : null;

const images = [ogImageObject, ...(cover ? [{ "@type": "ImageObject", url: abs(cover.src), width: cover.width, height: cover.height }] : [])];

const articleLd =
  type === "article"
    ? {
        "@type": "BlogPosting",
        "@id": `${canonicalUrl}#article`,
        headline: title,
        description,
        ...(abstract ? { abstract } : {}),
        image: images,
        datePublished: published,
        dateModified: modified,
        author: { "@id": PERSON_ID },
        publisher: { "@id": PERSON_ID },
        mainEntityOfPage: { "@id": pageId },
        keywords: tags.map(tagLabel).join(", "),
        articleSection: tags[0] ? tagLabel(tags[0]) : undefined,
        ...(readingStats
          ? { wordCount: readingStats.wordCount, timeRequired: readingStats.isoDuration }
          : {}),
        inLanguage: LOCALE.ld,
        isPartOf: { "@id": WEBSITE_ID },
      }
    : null;

const projectLd =
  type === "project"
    ? (() => {
        const base = {
          "@id": `${canonicalUrl}#project`,
          name: title,
          description,
          image: images,
          url: canonicalUrl,
          creator: { "@id": PERSON_ID },
          author: { "@id": PERSON_ID },
          mainEntityOfPage: { "@id": pageId },
          keywords: Array.from(new Set([...(projectMeta?.technologies ?? []), ...tags])).join(", "),
          ...(projectMeta?.url ? { sameAs: projectMeta.url } : {}),
          ...(published
            ? { datePublished: published, dateModified: modified }
            : projectMeta?.period?.match(/\d{4}/)
              ? { dateCreated: projectMeta.period.match(/\d{4}/)![0] }
              : {}),
          inLanguage: LOCALE.ld,
          isPartOf: { "@id": WEBSITE_ID },
        };
        // SoftwareApplication is rich-result eligible; plain CreativeWork
        // is not.
        if (projectMeta?.softwareApp) {
          return {
            "@type": "SoftwareApplication",
            ...base,
            applicationCategory: projectMeta.softwareApp.applicationCategory,
            operatingSystem: projectMeta.softwareApp.operatingSystem,
            offers: {
              "@type": "Offer",
              price: projectMeta.softwareApp.price ?? "0",
              priceCurrency: projectMeta.softwareApp.priceCurrency ?? "USD",
            },
          };
        }
        return { "@type": "CreativeWork", ...base };
      })()
    : null;

// Every page gets a WebPage-family node that ties it to the site, its
// breadcrumb and its main entity.
const pageType = profilePage
  ? "ProfilePage"
  : collectionItems && collectionItems.length > 0
    ? "CollectionPage"
    : "WebPage";
const pageLd = {
  "@type": pageType,
  "@id": pageId,
  url: canonicalUrl,
  name: fullTitle,
  description,
  inLanguage: LOCALE.ld,
  isPartOf: { "@id": WEBSITE_ID },
  primaryImageOfPage: ogImageObject,
  ...(breadcrumbLd ? { breadcrumb: { "@id": breadcrumbLd["@id"] } } : {}),
  ...(profilePage ? { mainEntity: { "@id": PERSON_ID }, about: { "@id": PERSON_ID } } : {}),
  ...(articleLd ? { mainEntity: { "@id": articleLd["@id"] } } : {}),
  ...(projectLd ? { mainEntity: { "@id": projectLd["@id"] } } : {}),
  ...(lastModified ? { dateModified: iso(lastModified) } : {}),
  ...(modified && (articleLd || projectLd) ? { dateModified: modified } : {}),
  ...(collectionItems && collectionItems.length > 0
    ? {
        mainEntity: {
          "@type": "ItemList",
          itemListOrder: "https://schema.org/ItemListOrderDescending",
          numberOfItems: collectionItems.length,
          itemListElement: collectionItems.map((it, i) => ({
            "@type": "ListItem",
            position: i + 1,
            url: abs(it.url),
            name: it.title,
            item: {
              "@type": collectionKind,
              "@id": abs(it.url),
              name: it.title,
              ...(it.description ? { description: it.description } : {}),
              ...(it.date ? { datePublished: iso(it.date) } : {}),
            },
          })),
        },
      }
    : {}),
};

const graph = [websiteLd, personLd, pageLd, articleLd, projectLd, faqLd, breadcrumbLd].filter(Boolean);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{metaKeywords && <meta name="keywords" content={metaKeywords} />}
<meta name="author" content={AUTHOR.name} />
<meta name="robots" content={robotsContent} />
<meta name="theme-color" content="#f6f8fb" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0c1015" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
<meta name="format-detection" content="telephone=no" />

<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
<link rel="alternate" type="application/rss+xml" title={`${SITE_NAME}${TITLE_SEPARATOR}Writing`} href={abs("/rss.xml")} />
<link rel="alternate" type="application/feed+json" title={`${SITE_NAME}${TITLE_SEPARATOR}Writing`} href={abs("/feed.json")} />
{markdownAlternate && <link rel="alternate" type="text/markdown" title="Markdown version" href={abs(markdownAlternate)} />}
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- IndieWeb / Mastodon identity verification + author profile linking -->
{SOCIALS.map((s) => <link rel="me" href={s.href} />)}
<link rel="author" href={abs("/about/")} />

<!-- Open Graph -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={LOCALE.og} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
{type === "article" && published && <meta property="article:published_time" content={published} />}
{type === "article" && modified && <meta property="article:modified_time" content={modified} />}
{type === "article" && <meta property="article:author" content={abs("/about/")} />}
{type === "article" && tags.map((tag) => <meta property="article:tag" content={tagLabel(tag)} />)}
{
  type === "profile" && (
    <>
      <meta property="profile:first_name" content={AUTHOR.givenName} />
      <meta property="profile:last_name" content={AUTHOR.familyName} />
      <meta property="profile:username" content={AUTHOR.username} />
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={AUTHOR.twitter} />
<meta name="twitter:creator" content={AUTHOR.twitter} />
<meta name="twitter:domain" content={SITE_HOST} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Structured data: one graph, so @id cross-references resolve inside a
     single document. -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })}
/>
