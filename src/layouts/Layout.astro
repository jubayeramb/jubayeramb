---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { SeoProps } from "@/types/seo";

type Props = SeoProps & {
  /**
   * Which top-level route is active in the nav. One of:
   * "home" | "now" | "projects" | "writings" | "ask" | "about" | "contact".
   * Inferred from the URL when omitted.
   */
  activeRoute?: string;
  /** Hide the footer (the /ask page is a full-height chat). */
  hideFooter?: boolean;
};

const { activeRoute, hideFooter = false, ...seoProps } = Astro.props;
---

<BaseLayout {...seoProps}>
  <slot name="head" slot="head" />
  <a class="skip-link" href="#main">Skip to content</a>
  <Header activeRoute={activeRoute} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  {!hideFooter && <Footer />}
</BaseLayout>
